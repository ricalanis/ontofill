{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/entity.schema.json",
  "title": "Generic gold entity JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "class", "classified_as", "properties", "links", "flags", "generated_by"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "class": {"type": "string", "minLength": 1},
    "classified_as": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "properties": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "common.schema.json#/$defs/field"}
    },
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "flags": {"type": "array", "items": {"$ref": "#/$defs/flag"}},
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"}
  },
  "$defs": {
    "link": {
      "type": "object", "additionalProperties": false,
      "required": ["property", "target", "via_value_id"],
      "properties": {
        "property": {"type": "string", "minLength": 1},
        "target": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "via_value_id": {"$ref": "common.schema.json#/$defs/value_id"}
      }
    },
    "flag": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "label", "explanation", "evidence_value_ids"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "evidence_value_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/value_id"}
        }
      }
    }
  }
}
