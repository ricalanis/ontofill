{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/record-mapping.schema.json",
  "title": "Versioned mapping from parsed record structure to ontology fields",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "input_fingerprint", "shape_signature", "mapping", "generated_by"],
  "properties": {
    "version": {"const": 1},
    "input_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "shape_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"},
    "mapping": {"$ref": "#/$defs/mapping"}
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes"],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/class_mapping"}
        }
      }
    },
    "class_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "collection_path", "identifier_property", "properties"],
      "properties": {
        "class_id": {"type": "string", "minLength": 1},
        "collection_path": {"type": "string", "maxLength": 512},
        "identifier_property": {"type": "string", "minLength": 1},
        "properties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/property_mapping"}
        }
      }
    },
    "property_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_id", "path"],
      "properties": {
        "property_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "maxLength": 512}
      }
    }
  }
}
