{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/metrics.schema.json",
  "title": "Generic gold run metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "entities_total", "entities_meeting_dod", "per_property_completeness",
    "distinct_source_classes", "values_without_evidence", "level_ratio_coverage",
    "mode_counts", "decisions_by_backend", "inference_backend", "dod", "generated_by"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "entities_total": {"$ref": "#/$defs/class_counts"},
    "entities_meeting_dod": {"$ref": "#/$defs/class_counts"},
    "per_property_completeness": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": {"$ref": "#/$defs/ratio"}
      }
    },
    "distinct_source_classes": {"type": "integer", "minimum": 0},
    "values_without_evidence": {"type": "integer", "minimum": 0},
    "level_ratio_coverage": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/ratio"}}
    },
    "mode_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["D0", "D1", "S1", "S2"],
      "properties": {
        "D0": {"type": "integer", "minimum": 0},
        "D1": {"type": "integer", "minimum": 0},
        "S1": {"type": "integer", "minimum": 0},
        "S2": {"type": "integer", "minimum": 0}
      }
    },
    "decisions_by_backend": {
      "type": "object",
      "propertyNames": {"enum": ["recorded", "vultr", "jev"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "inference_backend": {"enum": ["recorded", "vultr"]},
    "dod": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dod_result"}},
    "jobs": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "failed_by_reason"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "failed_by_reason": {
          "type": "object", "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "preview": {"type": "boolean"},
    "loops": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "iterations", "stop_reason", "usd"],
        "properties": {
          "phase": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 5}, {"const": "outer"}]},
          "iterations": {"type": "integer", "minimum": 0},
          "stop_reason": {"enum": ["checks_passed", "budget", "human", "max_iterations"]},
          "usd": {"type": "number", "minimum": 0}
        }
      }
    },
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"}
  },
  "$defs": {
    "class_counts": {
      "type": "object", "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "dod_result": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "query", "target", "actual", "met"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "target": {"type": "number", "minimum": 0},
        "actual": {"type": "number", "minimum": 0},
        "met": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"inference_backend": {"const": "recorded"}}},
      "then": {"properties": {"generated_by": {"properties": {"backend": {"const": "recorded"}}}}}
    },
    {
      "if": {"properties": {"inference_backend": {"const": "vultr"}}},
      "then": {"properties": {"generated_by": {"properties": {"backend": {"const": "vultr"}}}}}
    }
  ]
}
