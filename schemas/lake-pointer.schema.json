{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/lake-pointer.schema.json",
  "title": "Case lake.yaml, after YAML parsing",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "bronze", "silver", "gold"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "bronze": {"oneOf": [{"$ref": "#/$defs/bronze_s3"}, {"$ref": "#/$defs/bronze_file"}]},
    "silver": {
      "type": "object", "additionalProperties": false,
      "required": ["postgres_url_env", "rdf_store_url_env"],
      "properties": {
        "postgres_url_env": {"$ref": "#/$defs/env_name"},
        "rdf_store_url_env": {"$ref": "#/$defs/env_name"}
      }
    },
    "gold": {
      "type": "object", "additionalProperties": false,
      "required": ["rdf_store_url_env", "export"],
      "properties": {
        "rdf_store_url_env": {"$ref": "#/$defs/env_name"},
        "export": {
          "type": "array", "uniqueItems": true, "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        }
      }
    }
  },
  "$defs": {
    "env_name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "bronze_s3": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "bucket", "endpoint"],
      "properties": {
        "kind": {"const": "s3"},
        "bucket": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1}
      }
    },
    "bronze_file": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "root"],
      "properties": {
        "kind": {"const": "file"},
        "root": {"type": "string", "minLength": 1}
      }
    }
  }
}
