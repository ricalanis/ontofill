{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/approved.schema.json",
  "title": "APPROVED checkpoint file",
  "type": "object",
  "additionalProperties": false,
  "required": ["approver", "date"],
  "properties": {
    "approver": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "run_id": {"type": "string", "minLength": 1},
    "identity_source": {"enum": ["sso", "local", "sso-group"]},
    "unverified_name": {"type": "string", "minLength": 1},
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "via"],
      "properties": {
        "group": {"type": "string", "minLength": 1},
        "via": {"type": "string", "minLength": 1}
      }
    },
    "artifact_sha256": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "checkpoint": {"enum": ["prd", "factors", "ontology", "source", "action"]},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["approve", "deny"]},
    "reason": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"enum": ["accept", "reject"]}
    }
  },
  "allOf": [
    {
      "if": {"required": ["checkpoint"], "properties": {"checkpoint": {"enum": ["prd", "factors", "ontology", "action"]}}},
      "then": {"required": ["artifact_sha256", "identity_source"]}
    },
    {
      "if": {"required": ["decisions"]},
      "then": {"required": ["checkpoint"], "properties": {"checkpoint": {"const": "factors"}}}
    },
    {
      "if": {"properties": {"checkpoint": {"const": "source"}}, "required": ["checkpoint"]},
      "then": {"required": ["source_fingerprint"]}
    },
    {
      "if": {"properties": {"checkpoint": {"const": "action"}}, "required": ["checkpoint"]},
      "then": {"required": ["decision"]}
    },
    {
      "if": {"properties": {"decision": {"const": "deny"}}, "required": ["decision"]},
      "then": {"required": ["reason"]}
    }
  ]
}
