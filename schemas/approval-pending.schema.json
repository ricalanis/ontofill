{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/approval-pending.schema.json",
  "title": "Structured metadata for APPROVAL_PENDING.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "checkpoint", "requested_at", "reason", "artifact_paths", "generated_by"],
  "properties": {
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"},
    "phase": {"type": "integer", "minimum": 1, "maximum": 5},
    "checkpoint": {"enum": ["prd", "factors", "ontology", "source", "action"]},
    "source_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "screenshot_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
    "intended_action": {"type": "string", "minLength": 1},
    "risk_tier": {"enum": ["SAFE", "LOW", "HIGH"]},
    "job_id": {"type": "string", "minLength": 1},
    "requested_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "artifact_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"checkpoint": {"const": "source"}}, "required": ["checkpoint"]}, "then": {"required": ["source_fingerprint"], "properties": {"phase": {"const": 3}}}},
    {"if": {"properties": {"checkpoint": {"const": "action"}}, "required": ["checkpoint"]}, "then": {"required": ["screenshot_key", "intended_action", "risk_tier", "job_id"], "properties": {"phase": {"const": 5}}}}
  ]
}
