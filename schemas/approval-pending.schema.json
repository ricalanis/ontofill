{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/approval-pending.schema.json",
  "title": "Structured metadata for APPROVAL_PENDING.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "checkpoint", "requested_at", "reason", "artifact_paths", "generated_by"],
  "properties": {
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"},
    "phase": {"type": "integer", "minimum": 1, "maximum": 5},
    "checkpoint": {"enum": ["prd", "factors", "ontology"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "artifact_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
