{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/source-candidate.schema.json",
  "title": "Phase 3 source candidate and redirect authority packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id", "url", "provider", "capture_key", "fingerprint", "authority", "generated_by"
  ],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "title": {"type": "string"},
    "snippet": {"type": "string"},
    "provider": {"type": "string", "minLength": 1},
    "providers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "discovered_by": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "at"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "at": {"type": "string", "format": "date-time"},
        "query": {"type": "string", "minLength": 1},
        "evidence_key": {"$ref": "common.schema.json#/$defs/bronze_key"}
      }
    },
    "capture_key": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/bronze_key"},
        {"type": "null"}
      ]
    },
    "screenshot_key": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/bronze_key"},
        {"type": "null"}
      ]
    },
    "artifact_kind": {"enum": ["html", "download"]},
    "document_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
    "document_content_type": {"type": "string", "minLength": 1, "maxLength": 200},
    "document_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "source_type": {"type": ["string", "null"]},
    "authority": {"enum": ["auto", "review"]},
    "authority_tier": {"enum": ["primary", "secondary", "review", "unknown"]},
    "authority_reason": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "covers": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "landing_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "redirect_chain": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "format": "uri", "pattern": "^https?://"}
    },
    "property_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["quote", "capture_key", "url", "publisher_kinds", "authority_verdict"],
        "properties": {
          "quote": {"type": "string", "minLength": 1},
          "capture_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
          "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "publisher_kinds": {
            "type": "array", "items": {"type": "string", "minLength": 1}
          },
          "authority_verdict": {"type": "string", "minLength": 1},
          "critic_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "access_path": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind", "url", "capture_key", "access_path_quote", "authority_verdict", "critic_reason"
        ],
        "properties": {
          "kind": {"enum": ["search_form", "listing", "dataset", "download", "api", "metadata"]},
          "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "capture_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
          "access_path_quote": {"type": "string", "minLength": 1, "maxLength": 500},
          "property_quote": {"type": "string", "minLength": 1, "maxLength": 500},
          "authority_verdict": {"enum": ["authoritative", "not_authoritative", "unknown"]},
          "critic_reason": {"type": "string", "minLength": 1, "maxLength": 300},
          "form_index": {"type": "integer", "minimum": 0, "maximum": 39},
          "link_index": {"type": "integer", "minimum": 0, "maximum": 299},
          "content_type": {"type": "string", "minLength": 1, "maxLength": 200},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "document_format": {"enum": ["csv", "xlsx", "xlsm", "json", "pdf"]}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "search_form"}}, "required": ["kind"]},
            "then": {"required": ["form_index"]}
          }
        ]
      }
    },
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"}
  },
  "allOf": [
    {
      "if": {
        "required": ["provider", "capture_key"],
        "properties": {
          "provider": {"const": "sandbox_redirect"},
          "capture_key": {"type": "null"}
        }
      },
      "then": {
        "required": [
          "title", "snippet", "providers", "authority_tier", "authority_reason", "redirect_chain"
        ],
        "properties": {
          "authority": {"const": "review"},
          "redirect_chain": {"minItems": 2}
        }
      }
    },
    {
      "if": {"properties": {"artifact_kind": {"const": "download"}}, "required": ["artifact_kind"]},
      "then": {"required": ["document_key", "document_content_type"]}
    }
  ]
}
