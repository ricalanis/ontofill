{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/ontology-recommendations.schema.json",
  "title": "Unresolved Phase 2 ontology proposals",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ontology_path", "generated_by", "unresolved"],
  "properties": {
    "schema_version": {"const": "1"},
    "ontology_path": {"const": "02-ontology/ontology.json"},
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"},
    "unresolved": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved"}
    },
    "repairs": {
      "type": "array",
      "items": {"$ref": "#/$defs/repair"}
    },
    "query_repairs": {
      "type": "array",
      "items": {"$ref": "#/$defs/query_repair"}
    },
    "unresolved_criteria": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved_criterion"}
    }
  },
  "$defs": {
    "query_repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "fields", "approved_values", "reason"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["target", "operator", "min_ratio", "measure", "relation_id"]}
        },
        "approved_values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "operator"],
          "properties": {
            "target": {"type": "number", "minimum": 0},
            "operator": {"enum": [">=", ">", "=", "<=", "<"]},
            "min_ratio": {"type": "number", "minimum": 0, "maximum": 1},
            "compiled_as": {"const": "count_values_without_evidence <= 0"}
          }
        },
        "removed_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["min_ratio", "relation_id"]}
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "unresolved_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "metric",
        "reason",
        "approved_thresholds",
        "rejected_query"
      ],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "metric": {"type": "string"},
        "reason": {"type": "string", "minLength": 1},
        "approved_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "operator"],
          "properties": {
            "target": {"type": "number", "minimum": 0},
            "operator": {"enum": [">=", ">", "=", "<=", "<"]},
            "min_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        },
        "rejected_query": {"$ref": "dod-queries.schema.json#/$defs/query"}
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "requirement_id", "field", "reason", "property"],
      "properties": {
        "kind": {"const": "primary_dod_property"},
        "id": {"type": "string", "minLength": 1},
        "requirement_id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "property": {"$ref": "ontology.schema.json#/$defs/property"}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "reason", "proposal"],
      "properties": {
        "kind": {"enum": ["rule", "relation"]},
        "id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "proposal": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "rule"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "proposal": {"$ref": "ontology.schema.json#/$defs/rule"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "relation"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "proposal": {"$ref": "ontology.schema.json#/$defs/relation"}
            }
          }
        }
      ]
    }
  }
}
