{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/trace-step.schema.json",
  "title": "Execution trace JSONL step",
  "type": "object",
  "additionalProperties": false,
  "required": ["step_id", "run_id", "phase", "source_id", "objective_id", "tdd_path", "mode", "observed", "requested", "executed", "evaluated", "parent_step_id", "value_ids", "ts", "generated_by"],
  "properties": {
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"},
    "step_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"type": "integer", "minimum": 1, "maximum": 5},
    "source_id": {"type": ["string", "null"], "minLength": 1},
    "source_label": {"type": "string", "minLength": 1},
    "source_host": {"type": "string", "minLength": 1},
    "objective_id": {"type": ["string", "null"], "minLength": 1},
    "tdd_path": {"type": ["string", "null"], "minLength": 1},
    "mode": {"enum": ["D0", "D1", "S1", "S2"]},
    "event": {"enum": ["escalation", "crystallization", "repair", "hard_stop", "verify", "action_gate", "limit_kill", "quarantine", "loop", null]},
    "loop": {"$ref": "#/$defs/loop"},
    "usage": {"$ref": "#/$defs/usage"},
    "screen": {"$ref": "#/$defs/screen"},
    "verify": {"$ref": "#/$defs/verify"},
    "repair": {"$ref": "#/$defs/repair"},
    "gate": {"$ref": "#/$defs/gate"},
    "observed": {"$ref": "#/$defs/log_item"},
    "requested": {"$ref": "#/$defs/log_item"},
    "executed": {"$ref": "#/$defs/log_item"},
    "evaluated": {"$ref": "#/$defs/log_item"},
    "parent_step_id": {"type": ["string", "null"], "minLength": 1},
    "screenshot_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
    "value_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/value_id"}},
    "ts": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "verify"}}, "required": ["event"]}, "then": {"required": ["verify"]}},
    {"if": {"properties": {"event": {"const": "repair"}}, "required": ["event"]}, "then": {"required": ["repair"]}},
    {"if": {"properties": {"event": {"const": "action_gate"}}, "required": ["event"]}, "then": {"required": ["gate"]}},
    {"if": {"properties": {"event": {"const": "limit_kill"}}, "required": ["event"]}, "then": {"properties": {"evaluated": {"type": "object", "required": ["reason"], "properties": {"reason": {"enum": ["timeout", "memory", "pids", "max_steps"]}}}}}},
    {"if": {"properties": {"event": {"const": "quarantine"}}, "required": ["event"]}, "then": {"required": ["screen"], "properties": {"screen": {"properties": {"flagged": {"const": true}}}}}},
    {"if": {"properties": {"event": {"const": "loop"}}, "required": ["event"]}, "then": {"required": ["loop"]}},
    {"if": {"properties": {"screen": {"properties": {"flagged": {"const": true}}, "required": ["flagged"]}}, "required": ["screen"]}, "then": {"required": ["event"], "properties": {"event": {"const": "quarantine"}}}}
  ],
  "$defs": {
    "loop": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "iteration", "role"],
      "properties": {
        "phase": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 5}, {"const": "outer"}]},
        "iteration": {"type": "integer", "minimum": 1},
        "role": {"enum": ["gather", "propose", "critique", "revise", "check", "decide"]},
        "model": {"type": "string", "minLength": 1},
        "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verdict": {"type": "string", "minLength": 1},
        "objections": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "stop_reason": {"enum": ["checks_passed", "budget", "wall_clock", "human", "max_iterations"]}
      }
    },
    "log_item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capture_reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "navigation_attempts": {"$ref": "common.schema.json#/$defs/navigation_attempts"},
            "egress_events": {"$ref": "common.schema.json#/$defs/egress_events"},
            "artifact_kind": {"enum": ["page", "download"]},
            "document_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
            "document_content_type": {"type": "string", "minLength": 1, "maxLength": 128},
            "document_size_bytes": {"type": "integer", "minimum": 1, "maximum": 25165824}
          }
        },
        {"type": "string", "minLength": 1}
      ]
    },
    "screen": {
      "type": "object", "additionalProperties": false,
      "required": ["flagged", "jev_choice", "jev_confidence", "safety_verdict", "reason", "by"],
      "properties": {
        "flagged": {"type": "boolean"},
        "jev_choice": {"type": ["string", "null"]},
        "jev_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "safety_verdict": {"enum": ["safe", "unsafe", "unavailable"]},
        "reason": {"type": "string", "minLength": 1},
        "by": {"enum": ["gateway", "controller"]}
      }
    },
    "verify": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "verdict", "confidence", "backend", "model", "screenshot_key"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["achieved", "not_achieved", "uncertain"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "backend": {"enum": ["vultr", "jev"]},
        "model": {"type": "string", "minLength": 1},
        "screenshot_key": {"$ref": "common.schema.json#/$defs/bronze_key"}
      }
    },
    "repair": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt", "max_attempts", "code_key", "result", "stderr_excerpt", "diff_key", "test"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "code_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
        "result": {"enum": ["pass", "fail"]},
        "stderr_excerpt": {"type": "string"},
        "diff_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
        "test": {
          "type": "object", "additionalProperties": false,
          "required": ["pages", "precision", "coverage"],
          "properties": {
            "pages": {"type": "integer", "minimum": 0},
            "precision": {"type": "number", "minimum": 0, "maximum": 1},
            "coverage": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "risk_tier", "decided_by", "outcome", "approval_path"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "risk_tier": {"enum": ["SAFE", "LOW", "HIGH"]},
        "decided_by": {"enum": ["code", "jev", "vultr"]},
        "outcome": {"enum": ["allowed", "pending_approval", "denied"]},
        "approval_path": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "pending_approval"}}}, "then": {"properties": {"approval_path": {"type": "string", "minLength": 1}}}}
      ]
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "backend", "input_tokens", "output_tokens", "est_usd"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "backend": {"enum": ["recorded", "vultr", "jev"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "est_usd": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
