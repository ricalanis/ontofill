{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/factors.schema.json",
  "title": "Phase 2 factors of variation",
  "type": "object",
  "additionalProperties": false,
  "required": ["factors", "generated_by"],
  "properties": {
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"},
    "revisions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/revision"}},
    "factors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/factor"}}
  },
  "$defs": {
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "kind", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "kind": {"enum": ["grounded", "conceptual"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "description": {"type": "string", "minLength": 1},
        "bronze_key": {"$ref": "common.schema.json#/$defs/bronze_key"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "record_id", "quote"],
          "properties": {
            "type": {"const": "case_file"},
            "path": {"const": "01-scope/prd.json"},
            "record_id": {"type": "string", "minLength": 1},
            "quote": {"type": "string", "minLength": 1}
          }
        }
      },
      "anyOf": [{"required": ["url"]}, {"required": ["source"]}]
    }
  }
}
