{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ontofill.dev/schemas/global-prd.schema.json",
  "title": "Phase 1 global product requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "brief_path", "personas", "jobs_to_be_done", "requirements", "constraints", "non_goals", "definition_of_done", "authority_policy", "generated_by"],
  "properties": {
    "generated_by": {"$ref": "common.schema.json#/$defs/generated_by"},
    "revisions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/revision"}},
    "version": {"type": "string", "minLength": 1},
    "brief_path": {"type": "string", "minLength": 1},
    "personas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/persona"}},
    "jobs_to_be_done": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/job"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authority_policy": {"$ref": "#/$defs/authority_policy"},
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_issues": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}}
  },
  "$defs": {
    "authority_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["jurisdiction", "trusted_publishers", "unknown_source_action"],
      "properties": {
        "jurisdiction": {"type": "string", "minLength": 1},
        "trusted_publishers": {"type": "array", "items": {"$ref": "#/$defs/trusted_publisher"}},
        "unknown_source_action": {"const": "review"}
      }
    },
    "trusted_publisher": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "domains", "rationale"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "tier": {"enum": ["primary", "secondary"]},
        "domains": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"}
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "persona": {
      "type": "object", "additionalProperties": false, "required": ["id", "description"],
      "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}
    },
    "job": {
      "type": "object", "additionalProperties": false, "required": ["id", "persona_id", "description"],
      "properties": {"id": {"type": "string", "minLength": 1}, "persona_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}
    },
    "requirement": {
      "type": "object", "additionalProperties": false, "required": ["id", "job_id", "description"],
      "properties": {"id": {"type": "string", "minLength": 1}, "job_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}
    },
    "criterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "metric", "operator", "target", "basis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "operator": {"enum": [">=", ">", "=", "<=", "<"]},
        "target": {"type": "number", "minimum": 0},
        "min_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"enum": ["brief", "human", "proposed"]},
        "basis_quote": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "feasibility": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"basis": {"const": "proposed"}}, "required": ["basis"]},
         "then": {"required": ["rationale", "feasibility"]}},
        {"if": {"properties": {"basis": {"enum": ["brief", "human"]}}, "required": ["basis"]},
         "then": {"required": ["basis_quote"]}}
      ]
    }
  }
}
