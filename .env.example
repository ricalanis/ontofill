# Names only, no values committed.
VULTR_API_KEY=
# Consumed by infra/vultr/provision.py when composing cloud-init user data;
# use a short-lived NetBird setup key and rotate it after enrollment.
NETBIRD_SETUP_KEY=
NETBIRD_API_TOKEN=
NETBIRD_CONTROL_SETUP_KEY=
NETBIRD_SANDBOX_SETUP_KEY=
ONTOFILL_SANDBOX_DOCKER_HOST=
# On the control VM, point Docker's SSH transport at its dedicated sandbox key.
DOCKER_SSH_COMMAND=
# Engine calls go through the screened gateway; the old Vultr key name is a local fallback.
ONTOFILL_GATEWAY_TOKEN=
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=
VULTR_INFERENCE_MODEL=

# Phase 3 lead-only web search (optional; live runs only). Credits per run are capped.
TAVILY_API_KEY=
ONTOFILL_TAVILY_MAX_CREDITS=10

# Browser controller connection and shared capture paths; these paths must be shared with the controller service.
ONTOFILL_BROWSER_AGENT_MCP_URL=
ONTOFILL_BROWSER_AGENT_STEPS_ROOT=
ONTOFILL_BROWSER_AGENT_CAPTURES_ROOT=

# Local compose credentials and database name. Fill these in .env; never commit .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Local file lake. Configure top-level case_id, bronze.kind=file, and
# bronze.root in lake.yaml;
# LAKE_ROOT may override the local root during development.
LAKE_ROOT=
SILVER_DATABASE_URL=
OXIGRAPH_URL=

# Vultr Object Storage uses standard S3 credential names. Its endpoint and
# bucket are configured in lake.yaml, not here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
