#!/bin/sh
# Run the containment command from this tool's own environment.
#
#   tools/containment/bin/ontofill-containment --case <case_dir> --run-id <id>
#
# The tool reuses the engine package from the parent checkout via a uv path dependency,
# so `uv sync --extra dev` in tools/containment is enough (see README). Set the engine's
# env first (never print values):
#   set -a; . /opt/ontofill/engine.env; set +a
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
TOOL=$(dirname "$HERE")
if [ -x "$TOOL/.venv/bin/python" ]; then
  exec "$TOOL/.venv/bin/python" -m ontofill_containment.cli "$@"
fi
exec uv run --project "$TOOL" --extra dev ontofill-containment "$@"
